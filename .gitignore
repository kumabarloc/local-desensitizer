# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
# (build/dist used by both setuptools and PyInstaller)
build/
dist/
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test coverage
.coverage
htmlcov/
*.pycover

# Data files (keep structure, ignore actual data)
data/vault.db
data/*.db
data/backups/
data/snapshots/*.json
data/config.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log